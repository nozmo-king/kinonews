<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>KinoNews - Cinema Discussion</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: Verdana, Geneva, sans-serif;
      font-size: 10pt;
      background-color: #FFF7DD;
      color: #000;
    }

    #header {
      background-color: #80A1BA;
      padding: 4px;
      margin-bottom: 10px;
    }

    #header-inner {
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    #logo {
      font-weight: bold;
      color: #FFF7DD;
      font-size: 14pt;
      text-decoration: none;
      padding: 2px 6px;
      border: 2px solid #FFF7DD;
      background-color: #80A1BA;
    }

    #logo:hover {
      background-color: #91C4C3;
    }

    #nav {
      display: flex;
      gap: 10px;
      align-items: center;
      flex: 1;
    }

    #nav a {
      color: #FFF7DD;
      text-decoration: none;
      font-size: 10pt;
    }

    #nav a:hover {
      text-decoration: underline;
    }

    #user-info {
      color: #FFF7DD;
      font-size: 10pt;
    }

    #user-info a {
      color: #FFF7DD;
      text-decoration: none;
    }

    #user-info a:hover {
      text-decoration: underline;
    }

    #content {
      max-width: 1200px;
      margin: 0 auto;
      padding: 10px;
      background-color: #FFF7DD;
    }

    .post-list {
      background-color: #FFF7DD;
    }

    .post-item {
      padding: 4px 0;
      display: flex;
      gap: 5px;
    }

    .post-rank {
      color: #80A1BA;
      min-width: 30px;
      text-align: right;
      font-size: 10pt;
    }

    .post-vote {
      cursor: pointer;
      color: #80A1BA;
      font-size: 10pt;
      text-decoration: none;
      user-select: none;
    }

    .post-vote:hover {
      color: #91C4C3;
    }

    .post-main {
      flex: 1;
    }

    .post-title {
      font-size: 10pt;
    }

    .post-title a {
      color: #000;
      text-decoration: none;
    }

    .post-title a:hover {
      text-decoration: underline;
    }

    .post-title a:visited {
      color: #666;
    }

    .post-domain {
      color: #80A1BA;
      font-size: 8pt;
      margin-left: 5px;
    }

    .post-subtext {
      font-size: 8pt;
      color: #828282;
      margin-top: 2px;
    }

    .post-subtext a {
      color: #80A1BA;
      text-decoration: none;
    }

    .post-subtext a:hover {
      text-decoration: underline;
    }

    .comment-tree {
      margin-top: 10px;
    }

    .comment {
      margin-bottom: 10px;
      padding-left: 20px;
      border-left: 2px solid #B4DEBD;
    }

    .comment-head {
      font-size: 8pt;
      color: #828282;
      margin-bottom: 5px;
    }

    .comment-head a {
      color: #80A1BA;
      text-decoration: none;
    }

    .comment-head a:hover {
      text-decoration: underline;
    }

    .comment-text {
      font-size: 9pt;
      margin-bottom: 5px;
      line-height: 1.4;
    }

    .comment-reply {
      font-size: 8pt;
    }

    .comment-reply a {
      color: #80A1BA;
      text-decoration: none;
    }

    .comment-reply a:hover {
      text-decoration: underline;
    }

    .form-container {
      background-color: #FFF7DD;
      padding: 20px;
      max-width: 600px;
    }

    .form-group {
      margin-bottom: 15px;
    }

    .form-group label {
      display: block;
      margin-bottom: 5px;
      font-size: 10pt;
      color: #000;
    }

    .form-group input[type="text"],
    .form-group input[type="url"],
    .form-group textarea {
      width: 100%;
      padding: 8px;
      border: 1px solid #B4DEBD;
      background-color: #FFF7DD;
      font-family: inherit;
      font-size: 10pt;
    }

    .form-group input:focus,
    .form-group textarea:focus {
      outline: none;
      border-color: #91C4C3;
      background-color: #fff;
    }

    .form-group textarea {
      min-height: 100px;
      resize: vertical;
    }

    button[type="submit"],
    .btn {
      background-color: #80A1BA;
      color: #FFF7DD;
      border: none;
      padding: 8px 16px;
      cursor: pointer;
      font-size: 10pt;
      font-family: inherit;
    }

    button[type="submit"]:hover,
    .btn:hover {
      background-color: #91C4C3;
    }

    .spacer {
      height: 10px;
      background-color: #B4DEBD;
      margin: 20px 0;
    }

    .info-text {
      font-size: 9pt;
      color: #828282;
      margin-top: 10px;
      line-height: 1.4;
    }

    .post-detail {
      background-color: #FFF7DD;
      padding: 10px 0;
    }

    .post-detail-title {
      font-size: 12pt;
      margin-bottom: 10px;
    }

    .post-detail-title a {
      color: #000;
      text-decoration: none;
    }

    .post-detail-title a:hover {
      text-decoration: underline;
    }

    .post-detail-text {
      font-size: 9pt;
      margin: 10px 0;
      padding: 10px;
      background-color: #fff;
      border: 1px solid #B4DEBD;
      line-height: 1.4;
    }

    .user-profile {
      padding: 20px;
    }

    .user-profile-header {
      font-size: 12pt;
      margin-bottom: 20px;
      color: #80A1BA;
    }

    .user-section {
      margin-bottom: 30px;
    }

    .user-section h3 {
      font-size: 10pt;
      color: #80A1BA;
      margin-bottom: 10px;
    }

    .reply-form {
      margin-top: 10px;
      display: none;
      padding-left: 20px;
    }

    .reply-form.active {
      display: block;
    }

    .reply-form textarea {
      width: 100%;
      min-height: 60px;
      padding: 5px;
      border: 1px solid #B4DEBD;
      background-color: #FFF7DD;
      font-family: inherit;
      font-size: 9pt;
      margin-bottom: 5px;
    }
  </style>
</head>
<body>
  <div id="header">
    <div id="header-inner">
      <a href="/" id="logo">🎬 KinoNews</a>
      <div id="nav">
        <a href="/newest">new</a>
        <span style="color: #FFF7DD;">|</span>
        <a href="/submit">submit</a>
      </div>
      <div id="user-info">
        <% if (user) { %>
          <a href="/user/<%= user.username %>"><%= user.username %></a> (<%= user.id %>)
          <span style="color: #FFF7DD;">|</span>
          <a href="/logout">logout</a>
        <% } else { %>
          <a href="/login">login</a>
        <% } %>
      </div>
    </div>
  </div>

  <div id="content">
    <%- body %>
  </div>
</body>
</html>
