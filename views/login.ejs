<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login - KinoNews</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: Verdana, Geneva, sans-serif;
      font-size: 10pt;
      background-color: #FFF7DD;
      color: #000;
    }

    #header {
      background-color: #80A1BA;
      padding: 4px;
      margin-bottom: 10px;
    }

    #header-inner {
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    #logo {
      font-weight: bold;
      color: #FFF7DD;
      font-size: 14pt;
      text-decoration: none;
      padding: 2px 6px;
      border: 2px solid #FFF7DD;
      background-color: #80A1BA;
    }

    #logo:hover {
      background-color: #91C4C3;
    }

    #nav {
      display: flex;
      gap: 10px;
      align-items: center;
      flex: 1;
    }

    #nav a {
      color: #FFF7DD;
      text-decoration: none;
      font-size: 10pt;
    }

    #nav a:hover {
      text-decoration: underline;
    }

    #user-info {
      color: #FFF7DD;
      font-size: 10pt;
    }

    #user-info a {
      color: #FFF7DD;
      text-decoration: none;
    }

    #user-info a:hover {
      text-decoration: underline;
    }

    #content {
      max-width: 1200px;
      margin: 0 auto;
      padding: 10px;
      background-color: #FFF7DD;
    }

    .form-container {
      background-color: #FFF7DD;
      padding: 20px;
      max-width: 400px;
    }

    .form-group {
      margin-bottom: 15px;
    }

    .form-group label {
      display: block;
      margin-bottom: 5px;
      font-size: 10pt;
      color: #000;
    }

    .form-group input[type="text"] {
      width: 100%;
      padding: 8px;
      border: 1px solid #B4DEBD;
      background-color: #FFF7DD;
      font-family: inherit;
      font-size: 10pt;
    }

    .form-group input:focus {
      outline: none;
      border-color: #91C4C3;
      background-color: #fff;
    }

    button[type="submit"] {
      background-color: #80A1BA;
      color: #FFF7DD;
      border: none;
      padding: 8px 16px;
      cursor: pointer;
      font-size: 10pt;
      font-family: inherit;
    }

    button[type="submit"]:hover {
      background-color: #91C4C3;
    }

    .info-text {
      font-size: 9pt;
      color: #828282;
      margin-top: 10px;
      line-height: 1.4;
    }

    h2 {
      font-size: 12pt;
      margin-bottom: 20px;
      color: #80A1BA;
    }
  </style>
</head>
<body>
  <div id="header">
    <div id="header-inner">
      <a href="/" id="logo">🎬 KinoNews</a>
      <div id="nav">
        <a href="/newest">new</a>
        <span style="color: #FFF7DD;">|</span>
        <a href="/submit">submit</a>
      </div>
      <div id="user-info">
        <% if (user) { %>
          <a href="/user/<%= user.username %>"><%= user.username %></a> (<%= user.id %>)
          <span style="color: #FFF7DD;">|</span>
          <a href="/logout">logout</a>
        <% } else { %>
          <a href="/login">login</a>
        <% } %>
      </div>
    </div>
  </div>

  <div id="content">
    <div class="form-container">
      <h2>Login / Create Account</h2>
      <form action="/login" method="POST">
        <div class="form-group">
          <label for="username">Username</label>
          <input type="text" id="username" name="username" required minlength="2" placeholder="Choose a username">
        </div>

        <p class="info-text">
          Just enter a username to login or create a new account. It's that simple!
          If the username doesn't exist, we'll create it for you.
        </p>

        <button type="submit">Login / Create Account</button>
      </form>
    </div>
  </div>
</body>
</html>
